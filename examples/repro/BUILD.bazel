load("@rules_swift//swift:swift.bzl", "swift_library")
load("//apple:apple.bzl", "apple_static_xcframework")
load("//apple:resources.bzl", "apple_resource_bundle")

apple_resource_bundle(
    name = "FooBundle",
    resources = ["Foo.metal"],
    tags = ["manual"],
)

swift_library(
    name = "FooLib",
    srcs = ["Foo.swift"],
    data = [":FooBundle"],
    module_name = "Foo",
    tags = ["manual"],
)

apple_static_xcframework(
    name = "FooDevice",
    bundle_name = "Foo",
    ios = {"device": ["arm64"]},
    minimum_os_versions = {"ios": "15.0"},
    tags = ["manual"],
    deps = [":FooLib"],
)

apple_static_xcframework(
    name = "FooSimulator",
    bundle_name = "Foo",
    ios = {"simulator": ["arm64"]},
    minimum_os_versions = {"ios": "15.0"},
    tags = ["manual"],
    deps = [":FooLib"],
)

apple_static_xcframework(
    name = "Foo",
    bundle_name = "Foo",
    ios = {
        "device": ["arm64"],
        "simulator": ["arm64"],
    },
    minimum_os_versions = {"ios": "15.0"},
    tags = ["manual"],
    deps = [":FooLib"],
)
